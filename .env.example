DB_PASSWORD=PleaseChangeThisPasswordBeforeRunningTheApplication
DB_PORT=1433
BE_PORT=5049
FE_PORT=5173

# --- E-mail (local development: the Mailpit container from docker-compose.yml, web UI on MAILPIT_WEB_PORT) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# When set, every e-mail is sent to this address instead of the real recipient (testing against a real SMTP server).
SMTP_DEBUG_RECIPIENT=
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Development only: creates demo@example.com + a demo project on start (ignored outside Development) ---
SEED_DEMO_DATA=false
