# Copy to `.env` next to docker-compose.prod.yml and fill in EVERY value (the stack refuses to start otherwise).

# --- Database (not published outside the compose network) ---
DB_PASSWORD=

# --- Backend ---
# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it logs everybody out.
JWT_KEY=
# Public URL of the frontend (used for CORS and links in e-mails), e.g. https://agilium.example.com
FRONTEND_BASE_URL=
# Cloudflare Turnstile secret (login / registration / password reset are protected by it)
TURNSTILE_SECRET_KEY=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Published ports ---
BE_PORT=5049
FE_PORT=8080
# Public URL of the backend API as the BROWSER sees it (baked into the frontend build), e.g. https://api.agilium.example.com/api/v1
VITE_API_URL=
