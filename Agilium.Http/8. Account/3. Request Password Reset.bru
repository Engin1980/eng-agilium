meta {
  name: 3. Request Password Reset
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/password-reset/request
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "turnstileToken": ""
  }
}

docs {
  Always 204. The e-mail with the reset link (valid 15 minutes) appears in Mailpit.
}
