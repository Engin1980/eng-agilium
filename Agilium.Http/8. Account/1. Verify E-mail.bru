meta {
  name: 1. Verify E-mail
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "token": "{{verifyToken}}"
  }
}

docs {
  Single-use token from the verification e-mail (Mailpit, link /verify-email?token=...). 400 INVALID_TOKEN when unknown, used or expired (24 h).
}
