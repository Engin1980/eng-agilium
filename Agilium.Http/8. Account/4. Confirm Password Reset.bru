meta {
  name: 4. Confirm Password Reset
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/password-reset/confirm
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{password}}"
  }
}

docs {
  Single use; signs the user out everywhere, clears the failed-login counter and confirms the e-mail. Put the token from the Mailpit link into {{resetToken}}.
}
