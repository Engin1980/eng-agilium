meta {
  name: 5. Change Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{password}}"
  }
}

docs {
  Logged-in user. 400 when the current password is wrong; other sessions are signed out. (The request keeps the password unchanged - edit newPassword to try a real change.)
}
