meta {
  name: 1. Get Project
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/projects/{{projectId}}/templates/1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    // keep the whole tree (tables > columns > sections > items) for "2. Update Project"
    bru.setVar("taskTemplateTree", JSON.stringify(res.body.tables));
  }
}

docs {
  Returns the Task template (item type 1) of {{projectId}} as a tree: tables -> columns (width) ->
  sections (title) -> attributes (id, key, title, type 1-7, validatingRegex), each list ordered by its
  OrderIndex. Run "Projects/1. Create" first. Global templates are not editable and have no endpoint -
  each project owns a copy created from them.
}
