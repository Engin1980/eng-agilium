meta {
  name: 2. Update Project
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/projects/{{projectId}}/templates/1
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  { "tables": {{templateTablesJson}} }
}

script:pre-request {
  // Build a full-replace body from the tree captured by "1. Get Project":
  // keep everything, add a new Boolean attribute "blocked" (no id = create) to the first section and
  // drop the last attribute of the last section (missing = delete, together with its ItemFieldValues).
  const tables = JSON.parse(bru.getVar("taskTemplateTree"));
  const sections = tables.flatMap((t) => t.columns.flatMap((c) => c.sections));
  sections[0].items.push({ id: null, key: "blocked", title: "Blocked?", type: 5, validatingRegex: null });
  const withItems = sections.filter((s) => s.items.length > 0 && s !== sections[0]);
  if (withItems.length > 0) withItems[withItems.length - 1].items.pop();
  bru.setVar("templateTablesJson", JSON.stringify(tables));
}

docs {
  Run "1. Get Project" first. The whole template tree is replaced in one call: elements with an id are
  updated, elements without an id are created, elements missing from the body are deleted (an attribute
  is deleted together with its ItemFieldValue rows - the response returns "deletedFieldValues").
  The order of the lists is the order of the elements.

  Things to try on purpose: a column with "width": 0, a table with no columns, or two attributes with
  the same "key" (all rejected). A width sum other than 12 is NOT rejected - it is only expected.
}
