meta {
  name: 8. Get Field Values
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/projects/items/{{taskId}}/fields
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) {
    const descriptionField = res.body.fields.find((f) => f.key === "description");
    if (descriptionField) bru.setVar("taskDescriptionFieldId", descriptionField.templateItemId);
  }
}

docs {
  Returns the task's template fields merged with its (currently empty) values, and captures the
  "description" field's id into {{taskDescriptionFieldId}} for the next request.
}
